diff --git a/css/style.css b/css/style.css
index 7ac1fe1..0c3f6ea 100644
--- a/css/style.css
+++ b/css/style.css
@@ -1246,3 +1246,115 @@ h2{margin:.2em 0 .6em}
   text-align:center;vertical-align:baseline}
 .passage .cloze.cur{border-bottom-color:var(--accent);background:var(--accent-soft);
   color:var(--accent);font-weight:600}
+
+/* ===================== 阅读材料：可折叠 + 阅读排版 ===================== */
+/* 长阅读（截图那篇 side jobs 1600+ 字符）整屏都是材料，题干被顶到折叠线以下，
+   得先滚很久才知道在问什么。所以超长默认收起，给一个「展开全文」。 */
+.passage{position:relative;padding:14px 18px 16px}
+.passage-head{display:flex;align-items:center;gap:8px;margin-bottom:8px}
+.passage-tag{font-size:11px;font-weight:700;letter-spacing:.08em;color:var(--accent);
+  background:var(--accent-soft);padding:2px 8px;border-radius:5px}
+.passage-len{font-size:11px;color:var(--ink-soft);opacity:.75;font-variant-numeric:tabular-nums}
+.passage-body{line-height:1.85}
+.passage-body p{margin:0 0 .7em}
+.passage-body p:last-child{margin-bottom:0}
+/* 英文材料：西文字体在前，行距更松，限制每行字数（过长的行会让眼睛丢行） */
+.passage.en .passage-body{font-family:"Charter","Bitstream Charter","Iowan Old Style",Georgia,"Times New Roman",serif;
+  font-size:15.5px;line-height:1.95;letter-spacing:.005em;max-width:68ch;color:var(--ink)}
+.passage.folded .passage-body{max-height:11.5em;overflow:hidden}
+.passage.folded::after{content:'';position:absolute;left:1px;right:1px;bottom:38px;height:64px;
+  pointer-events:none;border-radius:0 0 10px 0;
+  background:linear-gradient(to bottom,transparent,var(--surface-2))}
+.passage-more{display:inline-flex;align-items:center;gap:5px;margin-top:10px;
+  border:1px solid var(--line);background:var(--surface);color:var(--ink-soft);
+  font:inherit;font-size:12.5px;font-weight:600;padding:5px 12px;border-radius:999px;cursor:pointer;
+  transition:border-color .15s,color .15s}
+.passage-more:hover{border-color:var(--accent);color:var(--accent)}
+.passage-more:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+
+/* 题干：紧跟材料时收紧上间距，题干本身略放大，和材料拉开层次 */
+.passage+.stem{position:relative;margin-top:16px;padding-top:2px;border-top:none}
+.stem{font-size:17.5px;line-height:1.65}
+/* 断点对齐仓库既有的 560px（原来 @media(max-width:560px) 把 .stem 压到 16px，
+   我这条在文件更后面，不跟着收就会把移动端的收缩规则整个盖掉） */
+@media(max-width:560px){
+  .passage.en .passage-body{font-size:15px;line-height:1.85}
+  .passage{padding:12px 14px 14px}
+  .stem{font-size:16px}
+}
+@media(prefers-reduced-motion:reduce){.opt,.passage-more{transition:none}}
+
+/* 英语知识卡片：formula 字段是句型结构而非 LaTeX，给它等宽 + 胶囊底，
+   和数学卡片的 KaTeX 胶囊保持同一种视觉分量 */
+.kcard-formula.is-text{font-family:var(--mono);font-size:13.5px;line-height:1.6;
+  background:color-mix(in srgb,var(--accent) 8%,transparent);color:var(--ink);
+  border-radius:8px;padding:6px 12px;display:inline-block;max-width:100%;
+  overflow-wrap:anywhere;opacity:1}
+.kcard-lg-front .kcard-formula.is-text{background:rgba(255,255,255,.25);font-size:15px}
+[data-theme=dark] .kcard-lg-front .kcard-formula.is-text{background:rgba(0,0,0,.25)}
+
+/* ===================== 追问：推理过程 + 回到底部 ===================== */
+/* 追问以前既不流式也没有思维链，现在两者都补上，样式跟主解析的推理区保持一路 */
+.chat-reason{margin:6px 0 8px}
+.chat-reason-h{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);
+  background:var(--surface);color:var(--ink-soft);font:inherit;font-size:12px;font-weight:600;
+  padding:4px 10px;border-radius:999px;cursor:pointer;transition:border-color .15s,color .15s}
+.chat-reason-h:hover{border-color:var(--accent);color:var(--accent)}
+.chat-reason-h:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+.chat-reason-b{margin-top:6px;max-height:220px;overflow:auto;white-space:pre-wrap;
+  font-size:12.5px;line-height:1.7;color:var(--ink-soft);
+  background:var(--surface-2);border-radius:10px;padding:10px 12px}
+
+/* 生成中用户往上滑了，就不再强行拽回底部，改成给一个可点的回去入口 */
+.back-bottom{position:sticky;bottom:14px;left:50%;transform:translateX(-50%);
+  display:inline-flex;align-items:center;gap:5px;z-index:5;
+  border:1px solid var(--line);background:var(--surface);color:var(--ink);
+  font:inherit;font-size:12.5px;font-weight:600;padding:6px 14px;border-radius:999px;
+  box-shadow:var(--shadow);cursor:pointer}
+.back-bottom:hover{border-color:var(--accent);color:var(--accent)}
+.back-bottom:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+@media(prefers-reduced-motion:reduce){.chat-reason-h,.back-bottom{transition:none}}
+
+/* ===================== AI 补答案：过程面板 ===================== */
+/* 原来只有一个「6 / 50」的计数，跑完既不知道哪些题被跳过，也不知道为什么。
+   后端每条本来就带 skip 原因和 warn，这里逐题显示出来。 */
+.fill-panel{margin:10px 0 4px;border:1px solid var(--line);border-radius:var(--radius);
+  background:var(--surface);box-shadow:var(--shadow);overflow:hidden}
+.fill-head{display:flex;align-items:center;gap:10px;padding:10px 14px;
+  border-bottom:1px solid color-mix(in srgb,var(--line) 70%,transparent)}
+.fill-title{font-size:13px;font-weight:700;color:var(--ink);white-space:nowrap}
+.fill-bar{flex:1;min-width:60px;height:6px;border-radius:999px;background:var(--surface-2);overflow:hidden}
+.fill-bar i{display:block;height:100%;background:var(--accent);border-radius:999px;
+  transition:width .3s ease}
+.fill-num{font-size:12px;color:var(--ink-soft);font-variant-numeric:tabular-nums;white-space:nowrap}
+.fill-tag{font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;white-space:nowrap}
+.fill-tag.ok{background:var(--ok-soft);color:var(--ok)}
+.fill-tag.skip{background:var(--surface-2);color:var(--ink-soft)}
+.fill-tag.fail{background:var(--bad-soft);color:var(--bad)}
+.fill-x{margin-left:auto;border:0;background:transparent;color:var(--ink-soft);
+  font-size:18px;line-height:1;cursor:pointer;padding:0 4px}
+.fill-x:hover{color:var(--ink)}
+
+.fill-log{max-height:240px;overflow:auto}
+.fill-row{display:flex;align-items:baseline;gap:8px;padding:6px 14px;font-size:12.5px;
+  border-bottom:1px solid color-mix(in srgb,var(--line) 40%,transparent)}
+.fill-row:last-child{border-bottom:0}
+.fill-dot{flex:none;width:6px;height:6px;border-radius:50%;background:var(--ink-soft);
+  transform:translateY(-1px)}
+.fill-row.ok .fill-dot{background:var(--ok)}
+.fill-row.warn .fill-dot{background:var(--warn)}
+.fill-row.fail .fill-dot{background:var(--bad)}
+.fill-row.skip{opacity:.7}
+.fill-stem{flex:1;min-width:0;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.fill-res{flex:none;max-width:45%;color:var(--ink-soft);font-size:12px;
+  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.fill-row.ok .fill-res{color:var(--ok);font-weight:600}
+.fill-row.fail .fill-res{color:var(--bad)}
+.fill-more,.fill-foot{padding:8px 14px;font-size:12px;color:var(--ink-soft)}
+.fill-foot{border-top:1px solid color-mix(in srgb,var(--line) 70%,transparent);background:var(--surface-2)}
+@media(max-width:560px){
+  .fill-head{flex-wrap:wrap;gap:6px}
+  .fill-bar{order:5;flex-basis:100%}
+  .fill-res{max-width:38%}
+}
+@media(prefers-reduced-motion:reduce){.fill-bar i{transition:none}}
