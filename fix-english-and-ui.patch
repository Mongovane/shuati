diff --git a/.gitignore b/.gitignore
new file mode 100644
index 0000000..2752eb9
--- /dev/null
+++ b/.gitignore
@@ -0,0 +1,2 @@
+node_modules/
+.DS_Store
diff --git a/css/style.css b/css/style.css
index 7ac1fe1..b5c84c3 100644
--- a/css/style.css
+++ b/css/style.css
@@ -241,7 +241,14 @@ a{color:var(--accent)}
 .prev-list{display:flex;flex-direction:column;gap:10px}
 .prev-item{display:flex;gap:10px;padding:12px;border:1px solid var(--line);border-radius:11px;background:var(--surface)}
 .prev-item.noans{border-color:color-mix(in srgb,var(--bad) 45%,var(--line))}
-.prev-item.off{opacity:.5}
+.prev-item.off{opacity:.45;filter:saturate(.4)}
+/* 勾选态给正向反馈：原来只有「未勾选变淡」，全选状态下满屏一个样，看不出这是可切换的 */
+.prev-item:not(.off){box-shadow:inset 3px 0 0 var(--accent)}
+.prev-item{transition:opacity .15s,box-shadow .15s,filter .15s}
+@media(pointer:fine){.prev-item:hover{border-color:color-mix(in srgb,var(--accent) 40%,var(--line))}}
+/* 查重：勾中=将被删除，用警示色而不只是删除线 */
+.dup-item.del{background:var(--bad-soft)}
+.dup-item.del:hover{background:var(--bad-soft)}
 .prev-ck{flex:none;padding-top:2px}
 .prev-ck input{width:18px;height:18px}
 .prev-body{flex:1;min-width:0}
@@ -1246,3 +1253,267 @@ h2{margin:.2em 0 .6em}
   text-align:center;vertical-align:baseline}
 .passage .cloze.cur{border-bottom-color:var(--accent);background:var(--accent-soft);
   color:var(--accent);font-weight:600}
+
+/* ===================== 阅读材料：可折叠 + 阅读排版 ===================== */
+/* 长阅读（截图那篇 side jobs 1600+ 字符）整屏都是材料，题干被顶到折叠线以下，
+   得先滚很久才知道在问什么。所以超长默认收起，给一个「展开全文」。 */
+.passage{position:relative;padding:14px 18px 16px}
+.passage-head{display:flex;align-items:center;gap:8px;margin-bottom:8px}
+.passage-tag{font-size:11px;font-weight:700;letter-spacing:.08em;color:var(--accent);
+  background:var(--accent-soft);padding:2px 8px;border-radius:5px}
+.passage-len{font-size:11px;color:var(--ink-soft);opacity:.75;font-variant-numeric:tabular-nums}
+.passage-body{line-height:1.85}
+.passage-body p{margin:0 0 .7em}
+.passage-body p:last-child{margin-bottom:0}
+/* 英文材料：西文字体在前，行距更松，限制每行字数（过长的行会让眼睛丢行） */
+.passage.en .passage-body{font-family:"Charter","Bitstream Charter","Iowan Old Style",Georgia,"Times New Roman",serif;
+  font-size:15.5px;line-height:1.95;letter-spacing:.005em;max-width:68ch;color:var(--ink)}
+.passage.folded .passage-body{max-height:11.5em;overflow:hidden}
+.passage.folded::after{content:'';position:absolute;left:1px;right:1px;bottom:38px;height:64px;
+  pointer-events:none;border-radius:0 0 10px 0;
+  background:linear-gradient(to bottom,transparent,var(--surface-2))}
+.passage-more{display:inline-flex;align-items:center;gap:5px;margin-top:10px;
+  border:1px solid var(--line);background:var(--surface);color:var(--ink-soft);
+  font:inherit;font-size:12.5px;font-weight:600;padding:5px 12px;border-radius:999px;cursor:pointer;
+  transition:border-color .15s,color .15s}
+.passage-more:hover{border-color:var(--accent);color:var(--accent)}
+.passage-more:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+
+/* 题干：紧跟材料时收紧上间距，题干本身略放大，和材料拉开层次 */
+.passage+.stem{position:relative;margin-top:16px;padding-top:2px;border-top:none}
+.stem{font-size:17.5px;line-height:1.65}
+/* 断点对齐仓库既有的 560px（原来 @media(max-width:560px) 把 .stem 压到 16px，
+   我这条在文件更后面，不跟着收就会把移动端的收缩规则整个盖掉） */
+@media(max-width:560px){
+  .passage.en .passage-body{font-size:15px;line-height:1.85}
+  .passage{padding:12px 14px 14px}
+  .stem{font-size:16px}
+}
+@media(prefers-reduced-motion:reduce){.opt,.passage-more{transition:none}}
+
+/* 英语知识卡片：formula 字段是句型结构而非 LaTeX，给它等宽 + 胶囊底，
+   和数学卡片的 KaTeX 胶囊保持同一种视觉分量 */
+.kcard-formula.is-text{font-family:var(--mono);font-size:13.5px;line-height:1.6;
+  background:color-mix(in srgb,var(--accent) 8%,transparent);color:var(--ink);
+  border-radius:8px;padding:6px 12px;display:inline-block;max-width:100%;
+  overflow-wrap:anywhere;opacity:1}
+.kcard-lg-front .kcard-formula.is-text{background:rgba(255,255,255,.25);font-size:15px}
+[data-theme=dark] .kcard-lg-front .kcard-formula.is-text{background:rgba(0,0,0,.25)}
+
+/* ===================== 追问：推理过程 + 回到底部 ===================== */
+/* 追问以前既不流式也没有思维链，现在两者都补上，样式跟主解析的推理区保持一路 */
+.chat-reason{margin:6px 0 8px}
+.chat-reason-h{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);
+  background:var(--surface);color:var(--ink-soft);font:inherit;font-size:12px;font-weight:600;
+  padding:4px 10px;border-radius:999px;cursor:pointer;transition:border-color .15s,color .15s}
+.chat-reason-h:hover{border-color:var(--accent);color:var(--accent)}
+.chat-reason-h:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+.chat-reason-b{margin-top:6px;max-height:220px;overflow:auto;white-space:pre-wrap;
+  font-size:12.5px;line-height:1.7;color:var(--ink-soft);
+  background:var(--surface-2);border-radius:10px;padding:10px 12px}
+
+/* 生成中用户往上滑了，就不再强行拽回底部，改成给一个可点的回去入口 */
+.back-bottom{position:sticky;bottom:14px;left:50%;transform:translateX(-50%);
+  display:inline-flex;align-items:center;gap:5px;z-index:5;
+  border:1px solid var(--line);background:var(--surface);color:var(--ink);
+  font:inherit;font-size:12.5px;font-weight:600;padding:6px 14px;border-radius:999px;
+  box-shadow:var(--shadow);cursor:pointer}
+.back-bottom:hover{border-color:var(--accent);color:var(--accent)}
+.back-bottom:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+@media(prefers-reduced-motion:reduce){.chat-reason-h,.back-bottom{transition:none}}
+
+/* ===================== AI 补答案：过程面板 ===================== */
+/* 原来只有一个「6 / 50」的计数，跑完既不知道哪些题被跳过，也不知道为什么。
+   后端每条本来就带 skip 原因和 warn，这里逐题显示出来。 */
+.fill-panel{margin:10px 0 4px;border:1px solid var(--line);border-radius:var(--radius);
+  background:var(--surface);box-shadow:var(--shadow);overflow:hidden}
+.fill-head{display:flex;align-items:center;gap:10px;padding:10px 14px;
+  border-bottom:1px solid color-mix(in srgb,var(--line) 70%,transparent)}
+.fill-title{font-size:13px;font-weight:700;color:var(--ink);white-space:nowrap}
+.fill-bar{flex:1;min-width:60px;height:6px;border-radius:999px;background:var(--surface-2);overflow:hidden}
+.fill-bar i{display:block;height:100%;background:var(--accent);border-radius:999px;
+  transition:width .3s ease}
+.fill-num{font-size:12px;color:var(--ink-soft);font-variant-numeric:tabular-nums;white-space:nowrap}
+.fill-tag{font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;white-space:nowrap}
+.fill-tag.ok{background:var(--ok-soft);color:var(--ok)}
+.fill-tag.skip{background:var(--surface-2);color:var(--ink-soft)}
+.fill-tag.fail{background:var(--bad-soft);color:var(--bad)}
+.fill-x{margin-left:auto;border:0;background:transparent;color:var(--ink-soft);
+  font-size:18px;line-height:1;cursor:pointer;padding:0 4px}
+.fill-x:hover{color:var(--ink)}
+
+.fill-log{max-height:240px;overflow:auto}
+.fill-row{display:flex;align-items:baseline;gap:8px;padding:6px 14px;font-size:12.5px;
+  border-bottom:1px solid color-mix(in srgb,var(--line) 40%,transparent)}
+.fill-row:last-child{border-bottom:0}
+.fill-dot{flex:none;width:6px;height:6px;border-radius:50%;background:var(--ink-soft);
+  transform:translateY(-1px)}
+.fill-row.ok .fill-dot{background:var(--ok)}
+.fill-row.warn .fill-dot{background:var(--warn)}
+.fill-row.fail .fill-dot{background:var(--bad)}
+.fill-row.skip{opacity:.7}
+.fill-stem{flex:1;min-width:0;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.fill-res{flex:none;max-width:45%;color:var(--ink-soft);font-size:12px;
+  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.fill-row.ok .fill-res{color:var(--ok);font-weight:600}
+.fill-row.fail .fill-res{color:var(--bad)}
+.fill-more,.fill-foot{padding:8px 14px;font-size:12px;color:var(--ink-soft)}
+.fill-foot{border-top:1px solid color-mix(in srgb,var(--line) 70%,transparent);background:var(--surface-2)}
+@media(max-width:560px){
+  .fill-head{flex-wrap:wrap;gap:6px}
+  .fill-bar{order:5;flex-basis:100%}
+  .fill-res{max-width:38%}
+}
+@media(prefers-reduced-motion:reduce){.fill-bar i{transition:none}}
+
+/* AI 用量小标：挨着模型名，把「谁吃掉了输出预算」摆出来 */
+.usage-chip{font-weight:400;font-size:11px;margin-left:6px;padding:1px 7px;border-radius:999px;
+  background:var(--surface-2);color:var(--ink-soft);cursor:help;white-space:nowrap;
+  font-variant-numeric:tabular-nums}
+
+/* ===================== 题库：选中态的视觉引导 ===================== */
+/* 原来「清空选择」是 btn subtle，和旁边一排按钮长得完全一样，
+   「已选 0」又是灰字 —— 选中了几十道题，界面上几乎没有反馈。 */
+.sel-count{font-size:12.5px;font-weight:600;color:var(--ink-soft);
+  padding:2px 10px;border-radius:999px;background:var(--surface-2);
+  font-variant-numeric:tabular-nums;transition:background .15s,color .15s}
+.sel-count.on{background:var(--accent);color:#fff}
+.btn.sel-clear{display:inline-flex;align-items:center;gap:5px;
+  border-color:var(--accent);color:var(--accent);background:var(--accent-soft);font-weight:600}
+.btn.sel-clear:hover{background:var(--accent);color:#fff;border-color:var(--accent)}
+[data-theme=dark] .sel-count.on{color:var(--bg)}
+[data-theme=dark] .btn.sel-clear:hover{color:var(--bg)}
+
+/* 选中时整行工具条给一条强调边，远看就知道「现在处于选中状态」 */
+.bank-toolbar.has-sel{box-shadow:inset 3px 0 0 var(--accent);border-radius:4px}
+
+/* ---- 移动端：工具条与面板 ---- */
+@media(max-width:560px){
+  .fill-head{flex-wrap:wrap;gap:6px 8px}
+  .fill-bar{order:5;flex-basis:100%;margin-top:2px}
+  .fill-x{order:4}
+  .fill-row{flex-wrap:wrap;gap:4px 8px;padding:8px 12px}
+  .fill-stem{flex-basis:100%;white-space:normal;line-height:1.5}
+  .fill-res{max-width:100%;margin-left:14px}
+  .fill-log{max-height:300px}
+  .sel-count,.btn.sel-clear{font-size:12px}
+}
+
+/* 无主内容（孤儿科目）提示：科目被删后，内容还在但分组显示成原始代码 */
+.orphan-box{border:1px solid var(--warn);background:color-mix(in srgb,var(--warn) 8%,transparent);
+  border-radius:10px;padding:12px 14px;margin-bottom:14px}
+.orphan-title{font-size:13px;font-weight:700;color:var(--warn);margin-bottom:4px}
+.orphan-desc{font-size:12.5px;line-height:1.7;color:var(--ink-soft);margin-bottom:8px}
+.orphan-row{display:flex;align-items:center;gap:10px;padding:6px 0;font-size:12.5px;
+  border-top:1px solid color-mix(in srgb,var(--warn) 20%,transparent)}
+.orphan-code{font-family:var(--mono);background:var(--surface-2);padding:2px 8px;border-radius:5px}
+.orphan-cnt{color:var(--ink-soft);font-variant-numeric:tabular-nums}
+@media(max-width:560px){ .orphan-row{flex-wrap:wrap;gap:6px} }
+
+/* 内置科目 chip：小圆点指示状态，比整颗高亮胶囊克制得多
+   灰点=正常 / 黄点=缺默认关键词 / 蓝点=科目被删了（可点重建） */
+.def-chips{display:flex;align-items:center;flex-wrap:wrap;gap:6px 14px;margin-bottom:14px}
+.def-chips-label{font-size:12px;font-weight:600;color:var(--ink-soft)}
+.def-chip{display:inline-flex;align-items:center;gap:6px;font:inherit;font-size:12.5px;
+  border:0;background:transparent;color:var(--ink-soft);padding:2px 0;cursor:default;
+  transition:color .15s}
+.def-dot{width:7px;height:7px;border-radius:50%;background:var(--ink-soft);opacity:.45;
+  flex:none;transition:background .15s,opacity .15s,box-shadow .15s}
+.def-chip.nokw,.def-chip.gone{cursor:pointer;color:var(--ink)}
+.def-chip.nokw .def-dot{background:var(--warn);opacity:1}
+.def-chip.gone .def-dot{background:var(--accent);opacity:1;
+  box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 18%,transparent)}
+.def-chip.nokw:hover{color:var(--warn)}
+.def-chip.gone:hover{color:var(--accent)}
+.def-chip.nokw:focus-visible,.def-chip.gone:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:4px}
+.def-chips-tip{font-size:11.5px;color:var(--ink-soft);opacity:.85;flex-basis:100%;line-height:1.6}
+@media(max-width:560px){ .def-chips{gap:6px 12px} }
+
+/* 整本抽题：把进度摆在按钮旁边。matProg 的进度条在书架顶部，
+   点完底栏的按钮往往已经滚不到那儿了，看起来像卡死。 */
+.bk-extract-prog{display:inline-flex;align-items:center;gap:8px;font-size:12.5px;color:var(--ink-soft);
+  min-width:0;flex:1}
+.bk-extract-txt{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-variant-numeric:tabular-nums}
+.bk-extract-bar{flex:none;width:90px;height:5px;border-radius:999px;background:var(--surface-2);overflow:hidden}
+.bk-extract-bar i{display:block;height:100%;background:var(--accent);border-radius:999px;transition:width .25s}
+@media(max-width:560px){
+  .bk-extract-prog{flex-basis:100%;order:9}
+  .bk-extract-bar{flex:1;width:auto}
+}
+
+/* 内置科目 chip 的居中确认弹窗。不用浏览器原生 confirm：
+   它弹在屏幕顶部、样式不可控，也没法把默认关键词列出来给用户过目。 */
+.chipdlg-mask{position:fixed;inset:0;z-index:60;background:rgba(20,25,40,.42);
+  display:flex;align-items:center;justify-content:center;padding:20px}
+.chipdlg{width:100%;max-width:460px;background:var(--surface);border:1px solid var(--line);
+  border-radius:var(--radius);box-shadow:0 12px 40px rgba(20,25,40,.18);overflow:hidden}
+.chipdlg-h{display:flex;align-items:center;gap:8px;padding:14px 16px;font-size:14px;font-weight:700;
+  color:var(--ink);border-bottom:1px solid var(--line)}
+.chipdlg-h .def-dot{width:8px;height:8px;opacity:1}
+.chipdlg-h .def-dot.nokw{background:var(--warn)}
+.chipdlg-h .def-dot.gone{background:var(--accent)}
+.chipdlg-x{margin-left:auto;border:0;background:transparent;color:var(--ink-soft);
+  font-size:20px;line-height:1;cursor:pointer;padding:0 2px}
+.chipdlg-x:hover{color:var(--ink)}
+.chipdlg-b{padding:14px 16px}
+.chipdlg-desc{margin:0 0 12px;font-size:13px;line-height:1.75;color:var(--ink-soft)}
+.chipdlg-row{display:flex;gap:10px;align-items:baseline;font-size:12.5px;margin-bottom:8px}
+.chipdlg-row:last-child{margin-bottom:0}
+.chipdlg-k{flex:none;color:var(--ink-soft)}
+.chipdlg-k em{font-style:normal;opacity:.75}
+.chipdlg-row code{font-family:var(--mono);background:var(--surface-2);padding:2px 8px;border-radius:5px}
+.chipdlg-kws{flex-direction:column;gap:6px}
+.chipdlg-kwlist{display:flex;flex-wrap:wrap;gap:5px;max-height:132px;overflow:auto}
+.chipdlg-kw{font-size:11.5px;background:var(--surface-2);color:var(--ink-soft);
+  padding:2px 7px;border-radius:999px}
+.chipdlg-f{display:flex;justify-content:flex-end;gap:8px;padding:12px 16px;
+  border-top:1px solid var(--line);background:var(--surface-2)}
+@media(max-width:560px){
+  .chipdlg-mask{padding:12px;align-items:flex-end}
+  .chipdlg{max-width:none}
+  .chipdlg-f .btn{flex:1}
+}
+
+/* ===================== 整本抽题：居中进度面板 ===================== */
+/* 底栏那行文字一滚就看不见了，而整本抽题动辄几分钟（载入 273 页 + 转存 343 张图），
+   必须有个不会跑掉的地方看进度。可「收起」去做别的，完成后照常弹预览。 */
+.exdlg-mask{position:fixed;inset:0;z-index:58;background:rgba(20,25,40,.38);
+  display:flex;align-items:center;justify-content:center;padding:20px}
+.exdlg{width:100%;max-width:430px;background:var(--surface);border:1px solid var(--line);
+  border-radius:var(--radius);box-shadow:0 12px 40px rgba(20,25,40,.2);overflow:hidden}
+.exdlg-h{display:flex;align-items:center;gap:9px;padding:14px 16px;border-bottom:1px solid var(--line)}
+.exdlg-title{font-size:14px;font-weight:700;color:var(--ink)}
+.exdlg-x{margin-left:auto;border:1px solid var(--line);background:var(--surface);
+  color:var(--ink-soft);font:inherit;font-size:12px;padding:3px 10px;border-radius:999px;cursor:pointer}
+.exdlg-x:hover{border-color:var(--accent);color:var(--accent)}
+.exdlg-b{padding:14px 16px}
+
+.exstep{display:flex;align-items:baseline;gap:9px;padding:5px 0;font-size:13px}
+.exstep-dot{flex:none;width:19px;height:19px;border-radius:50%;display:inline-flex;
+  align-items:center;justify-content:center;font-size:11px;font-style:normal;font-weight:700;
+  background:var(--surface-2);color:var(--ink-soft);transform:translateY(2px)}
+.exstep-t{font-weight:600;color:var(--ink-soft);white-space:nowrap}
+.exstep-d{font-size:11.5px;color:var(--ink-soft);opacity:.7;overflow:hidden;
+  text-overflow:ellipsis;white-space:nowrap}
+.exstep.done .exstep-dot{background:var(--ok-soft);color:var(--ok)}
+.exstep.done .exstep-t{color:var(--ink-soft)}
+.exstep.run .exstep-dot{background:var(--accent);color:#fff}
+.exstep.run .exstep-t{color:var(--ink)}
+.exstep.run .exstep-d{opacity:1}
+.exstep.wait{opacity:.5}
+[data-theme=dark] .exstep.run .exstep-dot{color:var(--bg)}
+
+.exdlg-now{margin-top:12px;font-size:12.5px;color:var(--ink);font-variant-numeric:tabular-nums;
+  min-height:1.4em}
+.exdlg-bar{margin-top:8px;height:6px;border-radius:999px;background:var(--surface-2);overflow:hidden}
+.exdlg-bar i{display:block;height:100%;background:var(--accent);border-radius:999px;transition:width .25s}
+/* 没有确定总数的阶段（解析/生成预览）：走一条来回滑动的条，表示"在动" */
+.exdlg-bar.indet i{width:38%;animation:exslide 1.1s ease-in-out infinite}
+@keyframes exslide{0%{margin-left:-38%}100%{margin-left:100%}}
+.exdlg-f{padding:11px 16px;border-top:1px solid var(--line);background:var(--surface-2);
+  font-size:11.5px;line-height:1.7;color:var(--ink-soft)}
+@media(max-width:560px){
+  .exdlg-mask{padding:12px}
+  .exstep-d{display:none}
+}
+@media(prefers-reduced-motion:reduce){.exdlg-bar.indet i{animation:none;width:100%;opacity:.5}}
