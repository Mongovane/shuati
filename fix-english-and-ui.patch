+  });
+  it('进度计数走到满，且不超过总数', async () => {
+    const { ctx, stat } = await run(okFetch(), [...mkQs(6), ...mkQs(3, 1000)]);
+    expect(ctx.bookExtract.done).toBe(stat.total);
